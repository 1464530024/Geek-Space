{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Geek Space",
  "version": "0.3.0",
  "identifier": "com.geekspace.desktop",
  "build": {
    "frontendDist": "../geek-space"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "极客空间 · Geek Space",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 660,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "theme": "Dark",
        "backgroundColor": "#0a0b0d"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "设备信息与硬件监控工作台",
    "longDescription": "极客空间 Geek Space — 实时硬件监控、有线连接联动与搞机工具箱",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
